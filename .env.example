# Copy to .env and fill in. .env is gitignored and must stay that way.

# Classic PAT, no scopes needed for public repos. Raises the API limit from
# 60 req/hr to 5,000, which the candidate-pool build requires.
GITHUB_TOKEN=

# Model gateway for the service and the labeller (DECISIONS.md D12).
OPENROUTER_API_KEY=
